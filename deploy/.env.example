# deploy/.env 로 복사해 값을 채웁니다. .env는 커밋하지 않습니다.

# 서비스 주소(https:// 없이). 예: kufim.duckdns.org
SITE_DOMAIN=

# 길고 무작위인 값으로 정하세요. 예: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=
REDIS_PASSWORD=

# 첫 실행에서만 채웁니다. 총괄 관리자 생성 후 지우고 `docker compose up -d`를 다시 실행합니다.
KUFIM_ADMIN_LOGIN=
KUFIM_ADMIN_PASSWORD=

# 입장 호출 문자(솔라피). 비워 두면 문자를 보내지 않고 화면 알림만 동작합니다.
# 발신번호는 solapi.com에 미리 등록해야 하며, 등록 전에는 3040으로 거부됩니다.
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER=
# 하루 발송 한도. 비용이 실제로 나가므로 기본값을 두었습니다.
SMS_DAILY_LIMIT=500

# 같은 공인 IP(캠퍼스 와이파이·통신사 NAT) 뒤의 이용자가 함께 쓰는 분당 웨이팅 접수 한도.
WAITING_PER_IP_PER_MINUTE=300

# API 문서(Swagger): https://SITE_DOMAIN/swagger-ui.html. 켜면 누구나 볼 수 있으니 공개 운영 중에는 false로 둡니다.
API_DOCS_ENABLED=false

# 부스 QR이 열 프론트 주소(끝에 / 없이). 비우면 https://SITE_DOMAIN. QR 인쇄 후에는 바꾸지 마세요.
FRONTEND_BASE_URL=https://kufim-fe.vercel.app

# 다른 주소에 배포한 프론트가 API를 직접 부를 때 허용할 출처(쉼표로 구분, 끝에 / 없이).
CORS_EXTRA_ORIGINS=https://kufim-fe.vercel.app

# KUFIM-FE 저장소 위치(이 폴더 기준). 두 저장소를 같은 상위 폴더에 받으면 기본값 그대로 됩니다.
FE_DIR=../../KUFIM-FE
